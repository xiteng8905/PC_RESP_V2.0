//
// Menu
//

IDR_MAINMENU MENUEX
BEGIN
    POPUP "Menu",                           65535,MFT_STRING,MFS_ENABLED
    BEGIN
        POPUP "工作状态设置",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "停止监测",                        ID_MODULESTOP,MFT_STRING,MFS_ENABLED
            MENUITEM "开始监测",                        ID_MODULESTART,MFT_STRING,MFS_ENABLED
        END
        POPUP "设置病人类型",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "成人",                          ID_SETADULTMODE,MFT_STRING,MFS_CHECKED
            MENUITEM "儿童",                          ID_SETCHILDMODE,MFT_STRING,MFS_ENABLED
            MENUITEM "新生儿",                         ID_SETNEWBORNMODE,MFT_STRING,MFS_ENABLED
        END
        POPUP "扫描速度",                           65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM " 62.50点/s",                   ID_SCAN500,MFT_STRING | MFT_RIGHTORDER,MFS_CHECKED
            MENUITEM "31.25点/s",                    ID_SCAN250,MFT_STRING,MFS_ENABLED
            MENUITEM "21.00点/s",                    ID_SCAN125,MFT_STRING,MFS_ENABLED
            MENUITEM "10.50点/s",                    ID_SCAN100,MFT_STRING,MFS_ENABLED
            MENUITEM "5.25点/s",                     ID_SCAN50,MFT_STRING,MFS_ENABLED
        END
        POPUP "呼吸灵敏度设置",                        65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "一级灵敏度（最不灵敏）",                 ID_SENSITIVTY1,MFT_STRING,MFS_ENABLED
            MENUITEM "二级灵敏度",                       ID_SENSITIVTY2,MFT_STRING,MFS_ENABLED
            MENUITEM "三级灵敏度",                       ID_SENSITIVTY3,MFT_STRING,MFS_ENABLED
            MENUITEM "四级灵敏度",                       ID_SENSITIVTY4,MFT_STRING,MFS_ENABLED
            MENUITEM "五级灵敏度",                       ID_SENSITIVTY5,MFT_STRING,MFS_ENABLED
        END
        MENUITEM "查询模块信息",                      ID_MENU_QUERYINFO,MFT_STRING,MFS_ENABLED
        MENUITEM "漏气检查",                        ID_MENU_CHECKLEAKAGE,MFT_STRING,MFS_ENABLED
        MENUITEM "复位模块",                        ID_MENU_RESETMODULE,MFT_STRING,MFS_ENABLED
        MENUITEM "设置基础压力",                      ID_MENU_SETBASEPRESS,MFT_STRING,MFS_ENABLED
        MENUITEM "刷新界面",                        ID_MENU_REBRUSH,MFT_STRING,MFS_ENABLED
    END
END

IDR_MENU_SLEEP MENU
BEGIN
    POPUP "SLEEP"
    BEGIN
        POPUP "Set Patient Type"
        BEGIN
            MENUITEM "Adult",                       ID_SETPATIENTTYPE_32835
            MENUITEM "Pediatric",                   ID_SETPATIENTTYPE_32836
            MENUITEM "Neonatal",                    ID_SETPATIENTTYPE_32837
        END
        MENUITEM "Data Analysis",               ID_SLEEP_DATAANALYSIS
        MENUITEM "Save Wave",                   ID_SLEEP_SAVEWAVE
        MENUITEM "Self Test",                   ID_SLEEP_SELFTEST
        MENUITEM "Quit",                        ID_SLEEP_QUIT
    END
END

